# Copy to .env and fill in as needed for the docker-compose deployment.
APP_ENV=production
# The household timezone (IANA); defaults to America/Denver.
# CONDUCTOR_TIMEZONE=America/Denver
# Recall by meaning (#147): the shared embeddings service (../embeddings/).
# The compose file points the container at host.docker.internal:8600; down or
# slow means word overlap alone. Set false to switch it off.
# CONDUCTOR_EMBEDDINGS=true
# EMBEDDINGS_BASE_URL=http://host.docker.internal:8600/v1
