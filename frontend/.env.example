# Dev server bind address. Default is loopback; set to 0.0.0.0 to expose on the LAN.
DEV_HOST=127.0.0.1

# API base URL. Leave unset to derive from the current host
# (http://<window.location.hostname>:8301), which works from LAN devices.
# Uncomment to pin an explicit backend URL:
# VITE_API_URL=http://127.0.0.1:8301
