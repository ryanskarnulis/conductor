# App
APP_ENV=development
# API bind address. Default is loopback-only; set to 0.0.0.0 to expose on the LAN.
API_HOST=127.0.0.1

# LLM provider (shared gemma-4-12b behind llama-swap). Defaults match the
# workspace stack; uncomment to override. From a container use
# http://host.docker.internal:8200/v1.
# LLAMACPP_BASE_URL=http://127.0.0.1:8200/v1
# LLAMACPP_MODEL=gemma-4-12b
# LLAMACPP_TIMEOUT_SECONDS=300.0

# Conductor loop's iteration cap (kept shallow — each iteration may wrap a full
# subagent loop).
# CONDUCTOR_MAX_ITERATIONS=6
