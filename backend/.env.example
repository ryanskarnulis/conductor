# App
APP_ENV=development
# API bind address. Default is loopback-only; set to 0.0.0.0 to expose on the LAN.
API_HOST=127.0.0.1

# SQLite file for conversations + the delegate-thread map, relative to backend/.
# The docker compose file overrides this with an absolute /data path.
DATABASE_URL=sqlite:///../data/conductor.db

# Per-IP requests/min on POST /api/agent/conversations/{id}/messages (the one
# model-calling endpoint). Trusted proxies are only set in docker (compose
# subnet), where nginx fronts the backend.
# AGENT_MESSAGES_PER_MIN=10
# TRUSTED_PROXY_IPS=

# LLM provider (shared gemma-4-12b behind llama-swap). Defaults match the
# workspace stack; uncomment to override. From a container use
# http://host.docker.internal:8200/v1.
# LLAMACPP_BASE_URL=http://127.0.0.1:8200/v1
# LLAMACPP_MODEL=gemma-4-12b
# LLAMACPP_TIMEOUT_SECONDS=300.0

# Conductor loop's iteration cap (kept shallow — each iteration may wrap a full
# subagent loop).
# CONDUCTOR_MAX_ITERATIONS=6

# Fleet discovery + delegation. Defaults suit dev (the workspace root holds the
# sibling apps' app.yaml files, all reachable on 127.0.0.1). In docker the
# compose file sets FLEET_MANIFEST_DIR=/fleet (a read-only mount) and
# FLEET_UPSTREAM_HOST=host.docker.internal (rewrites each manifest's upstream
# host so the container reaches host-bound app ports).
# FLEET_MANIFEST_DIR=/abs/path/to/workspace
# FLEET_UPSTREAM_HOST=
# Per-turn ceiling on repeat calls to any one app's delegate tool.
# CONDUCTOR_DELEGATE_CALLS_PER_TURN_PER_APP=3
